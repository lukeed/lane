---
type Props = {
	/** one entry per anchor, in document order */
	items: { slug: string; text: string }[];
};

let { items } = Astro.props;
---

<nav class="toc" aria-label="On this page">
	{items.map((item) => <a href={`#${item.slug}`}>{item.text}</a>)}
</nav>

<script>
	// mark the heading you are reading, so the rail says where you are
	let links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
	if (links.length) {
		let targets = links
			.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
			.filter((el): el is HTMLElement => el != null);

		let queued = false;

		function mark() {
			queued = false;
			let under =
				parseInt(getComputedStyle(document.documentElement).getPropertyValue('--top'), 10) + 60;
			// the last heading whose top has gone under the man rule
			let at = -1;
			for (let i = 0; i < targets.length; i++) {
				if (targets[i].getBoundingClientRect().top <= under) at = i;
			}
			links.forEach((a, i) => (a.dataset.here = String(i === at)));
		}

		addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(mark);
			},
			{ passive: true },
		);
		mark();
	}
</script>
