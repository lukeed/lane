#!/usr/bin/env bash
# .wt/pre-done — run AFTER the rebase onto trunk, BEFORE trunk fast-forwards.
#
# Ordering is the whole trick. Pending notes carry no span hashes; they get
# resolved here, against the post-rebase tree. Nothing is anchored to a SHA
# that the rebase is about to invalidate, so notes.rewriteRef is never needed.
set -euo pipefail

TRUNK="${WT_TRUNK:-main}"

ctx audit --base "$TRUNK" --json > /tmp/ctx-audit.json || exit 1
python3 - <<'PY'
import json
d = json.load(open("/tmp/ctx-audit.json"))
c, r, e = len(d["created"]), d["needs_review"], d["evicted"]
print("ctx: +%d notes, %d fresh, %d need review, %d evicted"
      % (c, d["checked"]["fresh"], len(r), len(e)))
for n in r:
    print("  review %s#%s [%s]" % (n["path"], n["anchor"], n["status"]))
PY

if ! git diff --quiet -- .context AGENTS.md; then
  git add .context AGENTS.md
  git commit -qm "ctx: update context memory" -- .context AGENTS.md
  echo "ctx: committed memory update"
fi
