#!/usr/bin/env bash
# .wt/post-create — reflink the expensive ignored dirs into the new worktree.
#
# `git worktree add` gives you a clean tree fast but a cold build cache. These
# dirs are gitignored, so git will never materialize them; copying them by
# reference costs ~0 bytes and ~0 seconds on APFS / btrfs / XFS(reflink=1) /
# ReFS / recent ZFS, and silently degrades to a real copy elsewhere.
set -euo pipefail

SRC="${WT_SOURCE:-$(git rev-parse --show-toplevel)}"
DST="${WT_WORKTREE:-$PWD}"
WARM="${WT_WARM_DIRS:-node_modules target .venv vendor dist .next .turbo .gradle}"

clone_dir() {
  local from="$1" to="$2"
  [ -d "$from" ] || return 0
  [ -e "$to" ] && return 0
  if cp --help 2>&1 | grep -q reflink; then
    cp -a --reflink=auto "$from" "$to"          # GNU coreutils
  else
    cp -Rc "$from" "$to" 2>/dev/null || cp -R "$from" "$to"   # macOS clonefile
  fi
}

for d in $WARM; do
  clone_dir "$SRC/$d" "$DST/$d" && echo "warmed $d"
done

# Verify we actually got CoW rather than a silent full copy.
if command -v filefrag > /dev/null 2>&1 && [ -d "$DST/node_modules" ]; then
  filefrag -v "$DST"/node_modules/* 2>/dev/null | grep -q shared \
    && echo "reflink: confirmed shared extents" \
    || echo "reflink: NOT shared — filesystem may not support it"
fi
